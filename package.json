{
  "name": "maharajothi-business-app",
  "version": "1.0.0",
  "description": "Maharajothi Enterprises - Business Management App",
  "main": "main.js",
  "author": "Maharajothi Enterprises",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.maharajothi.business",
    "productName": "Maharajothi Business App",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maharajothi Business App"
    },
    "files": [
      "**/*",
      "!server/auth_info/**",
      "!.git/**",
      "!*.bat",
      "!assets/**"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "app.asar.unpacked/server/node_modules"
      }
    ]
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  }
}
